# AWS Configuration
aws_region = "eu-north-1"

# Project Configuration
project_name = "rag-chatbot"
environment  = "dev"

# EC2 Configuration
ec2_instance_type = "t2.small"
ssh_key_name      = "your-key-pair-name"  # ← CHANGE THIS to your EC2 key pair name
my_ip             = "0.0.0.0/0"           # ← CHANGE THIS to your IP (format: 1.2.3.4/32)

# API Keys
gemini_api_key = "YOUR-GEMINI-API-KEY"    # ← CHANGE THIS to your actual key
